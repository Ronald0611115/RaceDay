
@model RaceDay.MVC.Models.EventFormViewModel

@{
    bool isEdit = Model.EventId > 0;
    ViewData["Title"] = isEdit ? "Edit Event" : "Create Event";
}

<div class="container mt-5 mb-5">
    <h1>@ViewData["Title"]</h1>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <form asp-controller="Organiser"
                  asp-action="@(isEdit ? "EditEvent" : "CreateEvent")"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EventId" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <button type="submit" class="btn btn-success">
                    @(isEdit ? "Save Changes" : "Create Event")
                </button>

                <a asp-controller="Organiser"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
