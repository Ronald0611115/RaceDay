
@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    int eventId = ViewBag.EventId;
}

<div class="container mt-5 mb-5">

    <h1>Manage Categories</h1>

    <p class="text-muted">
        View, edit and delete event registration categories.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="CreateCategory"
       asp-route-eventId="@eventId"
       class="btn btn-success mb-4">
        Add Category
    </a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No categories have been created for this event.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Entry Fee</th>
                        <th>Maximum Participants</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>R @category.EntryFee.ToString("N2")</td>
                            <td>@category.MaxParticipants</td>

                            <td>
                                <a asp-controller="Organiser"
                                   asp-action="EditCategory"
                                   asp-route-id="@category.CategoryId"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Organiser"
                                      asp-action="DeleteCategory"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@category.CategoryId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Delete this category?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
