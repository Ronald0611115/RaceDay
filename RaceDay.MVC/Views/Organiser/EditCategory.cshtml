
@model RaceDay.MVC.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5 mb-5">
    <h1>Edit Category</h1>

    <form asp-controller="Organiser"
          asp-action="EditCategory"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="CategoryId" />
        <input type="hidden" asp-for="EventId" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EntryFee" class="form-label"></label>
            <input asp-for="EntryFee"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="MaxParticipants" class="form-label"></label>
            <input asp-for="MaxParticipants"
                   type="number"
                   min="1"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">
            Save Changes
        </button>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
