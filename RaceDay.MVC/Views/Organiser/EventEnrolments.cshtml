
@model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-5 mb-5">

    <h1>Event Enrolments</h1>

    <p class="text-muted">
        View participants registered for this event.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No participants have registered for this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Enrolment ID</th>
                                <th>Participant ID</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrolment in Model)
                            {
                                <tr>
                                    <td>@enrolment.EnrolmentId</td>
                                    <td>@enrolment.ParticipantId</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(enrolment.CategoryName)
                                            ? $"Category #{enrolment.CategoryId}"
                                            : enrolment.CategoryName)
                                    </td>
                                    <td>
                                        @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">
                                            @enrolment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
