@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = Model.EventName;
}

<div class="container py-5">

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        ← Back to Events
    </a>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <img src="http://localhost:5252/api/events/@Model.EventId/banner"
                     alt="Banner for @Model.EventName"
                     class="card-img-top"
                     style="height:320px;object-fit:cover;"
                     onerror="this.style.display='none';" />

                <div class="card-body p-4">

                    <span class="badge bg-primary mb-3">
                        @Model.EventType
                    </span>

                    <h1 class="fw-bold">
                        @Model.EventName
                    </h1>

                    <hr />

                    <h4>About This Event</h4>

                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description available."
                            : Model.Description)
                    </p>

                </div>
            </div>
        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Event Information
                    </h4>

                    <p>
                        <strong>Date:</strong>
                        @Model.EventDate.ToString("dd MMMM yyyy")
                    </p>

                    <p>
                        <strong>Time:</strong>
                        @Model.EventDate.ToString("HH:mm")
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @Model.Location
                    </p>

                    <p>
                        <strong>Event Type:</strong>
                        @Model.EventType
                    </p>

                    <hr />

                    <button class="btn btn-warning w-100"
                            disabled>
                        Enrolment Coming Soon
                    </button>

                </div>
            </div>

        </div>
    </div>
</div>


@{
    var categories = ViewBag.Categories
        as List<RaceDay.MVC.Models.CategoryViewModel>
        ?? new List<RaceDay.MVC.Models.CategoryViewModel>();
}

<section class="container my-5">
    <h2 class="mb-4">Available Categories</h2>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }


    @if (categories.Any())
    {
        <div class="row g-4">
            @foreach (var category in categories)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @category.CategoryName
                            </h5>

                            <p class="card-text">
                                <strong>Entry Fee:</strong>
                                R @category.EntryFee.ToString("N2")
                            </p>

                            <p class="card-text">
                                <strong>Maximum Participants:</strong>
                                @category.MaxParticipants
                            </p>


                            @if (User.Identity?.IsAuthenticated == true &&
                                 User.IsInRole("Participant"))
                            {
                                <form asp-controller="Enrolments"
                                      asp-action="Create"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="categoryId"
                                           value="@category.CategoryId" />

                                    <input type="hidden"
                                           name="eventId"
                                           value="@category.EventId" />

                                    <button type="submit"
                                            class="btn btn-success w-100">
                                        Enrol Now
                                    </button>
                                </form>
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="btn btn-primary w-100">
                                    Sign In to Enrol
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100"
                                        disabled>
                                    Participant Access Only
                                </button>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No categories are currently available
            for this event.
        </div>
    }
</section>
