
@model List<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-5 mb-5">
    <h1 class="mb-3">My Results</h1>

    <p class="text-muted">
        View your recorded RaceDay finishing times and positions.
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No results have been recorded for your events yet.
            Results will appear after an Organiser publishes them.
        </div>

        <a asp-controller="Enrolments"
           asp-action="MyEnrolments"
           class="btn btn-primary">
            My Enrolments
        </a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Recorded At</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.EnrolmentId</td>
                            <td>@(result.FinishTime ?? "Not recorded")</td>
                            <td>@result.Position</td>
                            <td>@result.RecordedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
