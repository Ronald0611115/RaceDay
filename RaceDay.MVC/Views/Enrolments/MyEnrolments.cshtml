
@model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-5 mb-5">

    <h1 class="mb-3">My Enrolments</h1>

    <p class="text-muted mb-4">
        View your RaceDay event registrations and
        track your enrolment status.
    </p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(enrolment.EventName))
                                {
                                    <strong>@enrolment.EventName</strong>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Event unavailable
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(enrolment.CategoryName))
                                {
                                    @enrolment.CategoryName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Category unavailable
                                    </span>
                                }
                            </td>

                            <td>
                                @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @{
                                    var status = enrolment.Status ?? string.Empty;

                                    var badgeClass =
                                        status.Equals(
                                            "Confirmed",
                                            StringComparison.OrdinalIgnoreCase)
                                        ? "bg-success"
                                        : status.Equals(
                                            "Pending",
                                            StringComparison.OrdinalIgnoreCase)
                                        ? "bg-warning text-dark"
                                        : "bg-secondary";
                                }

                                <span class="badge @badgeClass">
                                    @status
                                </span>
                            </td>

                            <td>
                                @if (enrolment.EventId > 0)
                                {
                                    <a asp-controller="Home"
                                       asp-action="Details"
                                       asp-route-id="@enrolment.EventId"
                                       class="btn btn-outline-primary btn-sm">
                                        View Event
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Unavailable
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>
